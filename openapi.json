{
  "openapi": "3.0.3",
  "info": {
    "title": "MTranCore Translation Service API",
    "description": "Translation service supporting HTTP/REST, gRPC, and WebSocket protocols for machine translation using Bergamot engine",
    "version": "1.0.0",
    "contact": {
      "name": "MTranCore",
      "url": "https://github.com/xxnuo/MTranCore"
    },
    "license": {
      "name": "License",
      "url": "https://github.com/xxnuo/MTranCore/blob/main/LICENSE"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8988",
      "description": "Unified Server - HTTP/REST, gRPC, and WebSocket (all on port 8988)"
    }
  ],
  "tags": [
    {
      "name": "HTTP",
      "description": "HTTP/REST API endpoints"
    },
    {
      "name": "gRPC",
      "description": "gRPC service methods"
    },
    {
      "name": "WebSocket",
      "description": "WebSocket protocol messages"
    },
    {
      "name": "Health",
      "description": "Health check endpoints"
    },
    {
      "name": "Lifecycle",
      "description": "Engine lifecycle management (poweron/exit)"
    },
    {
      "name": "Translation",
      "description": "Translation operations"
    }
  ],
  "paths": {

    "/poweron": {
      "post": {
        "tags": ["HTTP", "Lifecycle"],
        "summary": "Power on engine (HTTP)",
        "description": "Load the translation engine with model files from specified path",
        "operationId": "poweronHttp",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PoweronRequest"
              },
              "examples": {
                "relative_path": {
                  "summary": "Relative path example",
                  "value": {
                    "path": "models/enzh"
                  }
                },
                "absolute_path": {
                  "summary": "Absolute path example",
                  "value": {
                    "path": "/usr/share/bergamot/models/enzh"
                  }
                },
                "individual_files": {
                  "summary": "Individual file paths example",
                  "value": {
                    "model_path": "models/enzh/model.enzh.intgemm.alphas.bin",
                    "lexical_shortlist_path": "models/enzh/lex.50.50.enzh.s2t.bin",
                    "vocabulary_path": "models/enzh/single_vocab.enzh.spm"
                  }
                },
                "individual_files_dual_vocab": {
                  "summary": "Individual file paths with dual vocabularies",
                  "value": {
                    "model_path": "models/enzh/model.enzh.intgemm.alphas.bin",
                    "lexical_shortlist_path": "models/enzh/lex.50.50.enzh.s2t.bin",
                    "vocabulary_paths": [
                      "models/enzh/srcvocab.enzh.spm",
                      "models/enzh/trgvocab.enzh.spm"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or error response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Engine loaded successfully",
                    "value": {
                      "code": 200,
                      "data": {
                        "message": "Engine loaded successfully"
                      }
                    }
                  },
                  "path_not_exists": {
                    "summary": "Path does not exist",
                    "value": {
                      "code": 1001,
                      "message": "path does not exist: /invalid/path"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/exit": {
      "post": {
        "tags": ["HTTP", "Lifecycle"],
        "summary": "Power off server (HTTP)",
        "description": "Gracefully shut down the server with optional delay and force flag",
        "operationId": "exitHttp",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExitRequest"
              },
              "examples": {
                "immediate": {
                  "summary": "Immediate shutdown",
                  "value": {
                    "time": 0,
                    "force": false
                  }
                },
                "delayed": {
                  "summary": "Delayed shutdown (5 seconds)",
                  "value": {
                    "time": 5,
                    "force": false
                  }
                },
                "force": {
                  "summary": "Force shutdown",
                  "value": {
                    "time": 0,
                    "force": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Shutdown initiated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["HTTP", "Lifecycle"],
        "summary": "Check engine health status (HTTP)",
        "description": "Check if the translation engine is loaded and health to process requests",
        "operationId": "healthHttp",
        "responses": {
          "200": {
            "description": "Health status",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/StandardResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/HealthResponse"
                        }
                      }
                    }
                  ]
                },
                "examples": {
                  "health": {
                    "summary": "Engine is health",
                    "value": {
                      "code": 200,
                      "data": {
                        "health": true
                      }
                    }
                  },
                  "not_health": {
                    "summary": "Engine is not health",
                    "value": {
                      "code": 200,
                      "data": {
                        "health": false
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trans": {
      "post": {
        "tags": ["HTTP", "Translation"],
        "summary": "Translate text (HTTP)",
        "description": "Translate text using the loaded translation engine",
        "operationId": "transHttp",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransRequest"
              },
              "examples": {
                "plain_text": {
                  "summary": "Plain text translation",
                  "value": {
                    "text": "Hello, world!",
                    "html": false
                  }
                },
                "html_text": {
                  "summary": "HTML text translation",
                  "value": {
                    "text": "<p>Hello, <strong>world</strong>!</p>",
                    "html": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Translation result (plain text)",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                },
                "examples": {
                  "success": {
                    "summary": "Successful translation",
                    "value": "你好，世界！"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          },
          "500": {
            "description": "Translation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          },
          "503": {
            "description": "Server is shutting down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/grpc/TranslatorService/Health": {
      "post": {
        "tags": ["gRPC", "Health"],
        "summary": "Health check (gRPC)",
        "description": "gRPC health check method",
        "operationId": "healthGrpc",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Health response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/grpc/TranslatorService/Poweron": {
      "post": {
        "tags": ["gRPC", "Lifecycle"],
        "summary": "Power on engine (gRPC)",
        "description": "Load the translation engine with model files",
        "operationId": "poweronGrpc",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PoweronRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Poweron response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PoweronResponse"
                }
              }
            }
          }
        }
      }
    },
    "/grpc/TranslatorService/Exit": {
      "post": {
        "tags": ["gRPC", "Lifecycle"],
        "summary": "Power off server (gRPC)",
        "description": "Shut down the gRPC server",
        "operationId": "exitGrpc",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExitRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exit response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExitResponse"
                }
              }
            }
          }
        }
      }
    },
    "/grpc/TranslatorService/Health": {
      "post": {
        "tags": ["gRPC", "Lifecycle"],
        "summary": "Check engine health status (gRPC)",
        "description": "Get the current engine status",
        "operationId": "healthGrpc",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Health response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponseGrpc"
                }
              }
            }
          }
        }
      }
    },
    "/grpc/TranslatorService/Trans": {
      "post": {
        "tags": ["gRPC", "Translation"],
        "summary": "Translate text (gRPC)",
        "description": "Translate a single text using gRPC",
        "operationId": "transGrpc",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransRequestGrpc"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trans response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransResponseGrpc"
                }
              }
            }
          }
        }
      }
    },
    "/grpc/TranslatorService/TransStream": {
      "post": {
        "tags": ["gRPC", "Translation"],
        "summary": "Translate text stream (gRPC)",
        "description": "Translate multiple texts in streaming fashion using bidirectional gRPC stream",
        "operationId": "transStreamGrpc",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Stream of TransRequest messages",
                "properties": {
                  "stream": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/TransRequestGrpc"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stream of trans responses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "stream": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/TransResponseGrpc"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ws": {
      "get": {
        "tags": ["WebSocket"],
        "summary": "WebSocket endpoint",
        "description": "WebSocket connection endpoint for bidirectional communication. Supports poweron, exit, health, and trans message types.",
        "operationId": "websocketConnect",
        "parameters": [
          {
            "name": "Connection",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["Upgrade"]
            }
          },
          {
            "name": "Upgrade",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["websocket"]
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/WSResponse"
                    }
                  ]
                },
                "examples": {
                  "poweron_success": {
                    "summary": "Poweron success response",
                    "value": {
                      "type": "poweron",
                      "code": 200,
                      "msg": "success",
                      "data": {
                        "message": "Engine loaded successfully"
                      }
                    }
                  },
                  "trans_success": {
                    "summary": "Trans success response",
                    "value": {
                      "type": "trans",
                      "code": 200,
                      "msg": "success",
                      "data": {
                        "translated_text": "你好，世界！"
                      }
                    }
                  },
                  "health_response": {
                    "summary": "Health status response",
                    "value": {
                      "type": "health",
                      "code": 200,
                      "msg": "success",
                      "data": {
                        "health": true
                      }
                    }
                  }
                }
              }
            }
          },
          "426": {
            "description": "Upgrade Required - Not a WebSocket request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PoweronRequest": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to model directory. Can be absolute or relative to work directory. Optional if individual file paths are provided.",
            "example": "models/enzh"
          },
          "model_path": {
            "type": "string",
            "description": "Path to model file. Takes priority over path. Can be absolute or relative to work directory.",
            "example": "models/enzh/model.enzh.intgemm.alphas.bin"
          },
          "lexical_shortlist_path": {
            "type": "string",
            "description": "Path to lexical shortlist file. Takes priority over path. Can be absolute or relative to work directory.",
            "example": "models/enzh/lex.50.50.enzh.s2t.bin"
          },
          "vocabulary_path": {
            "type": "string",
            "description": "Path to vocabulary file. Merged with vocabulary_paths (vocabulary_path first). Can be absolute or relative to work directory.",
            "example": "models/enzh/single_vocab.enzh.spm"
          },
          "vocabulary_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Paths to vocabulary files. Merged with vocabulary_path (vocabulary_path first). Can be absolute or relative to work directory.",
            "example": ["models/enzh/srcvocab.enzh.spm", "models/enzh/trgvocab.enzh.spm"]
          }
        }
      },
      "ExitRequest": {
        "type": "object",
        "properties": {
          "time": {
            "type": "integer",
            "format": "int32",
            "description": "Seconds to wait before shutdown",
            "default": 0,
            "minimum": 0,
            "example": 5
          },
          "force": {
            "type": "boolean",
            "description": "Force shutdown without waiting for requests",
            "default": false,
            "example": false
          }
        }
      },
      "TransRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to translate",
            "example": "Hello, world!"
          },
          "html": {
            "type": "boolean",
            "description": "Whether the text contains HTML markup",
            "default": false,
            "example": false
          }
        }
      },
      "TransRequestGrpc": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": {
            "type": "string",
            "description": "Text to translate"
          },
          "html": {
            "type": "boolean",
            "description": "Whether the text contains HTML markup",
            "default": false
          }
        }
      },
      "TransResponse": {
        "type": "object",
        "properties": {
          "translated_text": {
            "type": "string",
            "description": "Translated text",
            "example": "你好，世界！"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "health": {
            "type": "boolean",
            "description": "Whether the engine is health",
            "example": true
          }
        }
      },
      "StandardResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "Response code (0 for success, non-zero for errors)",
            "example": 0
          },
          "message": {
            "type": "string",
            "description": "Response message (usually present for errors)",
            "example": "Success"
          },
          "data": {
            "type": "object",
            "description": "Response data (present for successful requests)",
            "additionalProperties": true
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "OK"
          }
        }
      },
      "PoweronResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "Engine loaded successfully"
          }
        }
      },
      "ExitResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "Server is shutting down"
          }
        }
      },
      "HealthResponseGrpc": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "OK"
          },
          "health": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "TransResponseGrpc": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "OK"
          },
          "translated_text": {
            "type": "string",
            "example": "你好，世界！"
          }
        }
      },
      "WSMessage": {
        "type": "object",
        "description": "WebSocket request message",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["poweron", "exit", "health", "trans"],
            "description": "Message type",
            "example": "trans"
          },
          "data": {
            "type": "object",
            "description": "Message data, structure depends on type",
            "oneOf": [
              {
                "$ref": "#/components/schemas/PoweronRequest"
              },
              {
                "$ref": "#/components/schemas/ExitRequest"
              },
              {
                "$ref": "#/components/schemas/TransRequest"
              },
              {
                "type": "object",
                "description": "Empty object for health message"
              }
            ]
          }
        },
        "examples": [
          {
            "type": "poweron",
            "data": {
              "path": "models/enzh"
            }
          },
          {
            "type": "trans",
            "data": {
              "text": "Hello, world!",
              "html": false
            }
          },
          {
            "type": "health",
            "data": {}
          }
        ]
      },
      "WSResponse": {
        "type": "object",
        "description": "WebSocket response message",
        "required": ["type", "code", "msg"],
        "properties": {
          "type": {
            "type": "string",
            "description": "Same as request type",
            "example": "trans"
          },
          "code": {
            "type": "integer",
            "description": "Response code (0 for success)",
            "example": 0
          },
          "msg": {
            "type": "string",
            "description": "Response message",
            "example": "success"
          },
          "data": {
            "type": "object",
            "description": "Response data (optional)",
            "additionalProperties": true
          }
        }
      },
      "ErrorCodes": {
        "type": "object",
        "description": "Standard error codes used across all protocols",
        "properties": {
          "0": {
            "type": "string",
            "description": "Success",
            "example": "Success"
          },
          "1000": {
            "type": "string",
            "description": "Poweron: Invalid parameters"
          },
          "1001": {
            "type": "string",
            "description": "Poweron: Path does not exist"
          },
          "1002": {
            "type": "string",
            "description": "Poweron: Incomplete model files"
          },
          "1003": {
            "type": "string",
            "description": "Poweron: Internal error"
          },
          "1009": {
            "type": "string",
            "description": "Poweron: Unknown error"
          },
          "1100": {
            "type": "string",
            "description": "Exit: Invalid parameters"
          },
          "1101": {
            "type": "string",
            "description": "Exit: Waiting for tasks to complete"
          },
          "1109": {
            "type": "string",
            "description": "Exit: Internal error"
          },
          "1200": {
            "type": "string",
            "description": "Trans: Invalid parameters"
          },
          "1201": {
            "type": "string",
            "description": "Trans: Translation failure"
          },
          "1209": {
            "type": "string",
            "description": "Trans: Internal error"
          }
        }
      }
    }
  }
}
